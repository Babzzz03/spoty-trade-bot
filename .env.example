# Copy to .env and fill in. Never commit .env.
SPORTMONKS_API_TOKEN=your_sportmonks_token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_BotFather
# Optional: IANA timezone used for "today" and kick-off times
BOT_TIMEZONE=Africa/Lagos
# Optional: comma-separated Sportmonks league IDs to show by default (empty = all on your plan)
DEFAULT_LEAGUE_IDS=
# Optional: Postgres connection string for alerts + scorecard (e.g. Supabase "Session pooler" URI).
# Without it a local SQLite file is used, which Render's free plan wipes on every restart.
DATABASE_URL=
# Optional: daily lead scan time (local, HH:MM)
SCAN_TIME=08:00
# Optional but recommended: comma-separated Telegram chat IDs allowed to use the bot (/start shows yours)
ALLOWED_CHAT_IDS=
